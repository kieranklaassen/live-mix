{
  "name": "@kieranklaassen/live-mix",
  "version": "0.1.0",
  "description": "Ableton-like browser mixing engine: tracks, sends, transport, clip scheduling, live input and WASM devices on raw Web Audio + AudioWorklet.",
  "type": "module",
  "license": "MIT",
  "author": "Kieran Klaassen",
  "homepage": "https://github.com/kieranklaassen/live-mix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieranklaassen/live-mix.git"
  },
  "bugs": {
    "url": "https://github.com/kieranklaassen/live-mix/issues"
  },
  "keywords": [
    "web-audio",
    "audioworklet",
    "wasm",
    "mixer",
    "daw",
    "transport",
    "reverb",
    "dattorro",
    "faust",
    "zita-rev1",
    "limiter",
    "wam",
    "webaudiomodules"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "cpp",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsp": {
      "types": "./dist/dsp/index.d.ts",
      "default": "./dist/dsp/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./wam": {
      "types": "./dist/wam/index.d.ts",
      "default": "./dist/wam/index.js"
    },
    "./worklets/*": "./dist/worklets/*",
    "./wasm/*": "./dist/wasm/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "bash scripts/test-native.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:faust": "bash scripts/build-faust.sh",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:snapshot": "changeset version --snapshot next && pnpm build && changeset publish --tag next --no-git-tag"
  },
  "peerDependencies": {
    "@webaudiomodules/api": "2.0.0-alpha.6",
    "@webaudiomodules/sdk": "0.0.12",
    "react": ">=18",
    "signalsmith-stretch": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@webaudiomodules/api": {
      "optional": true
    },
    "@webaudiomodules/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "signalsmith-stretch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webaudiomodules/api": "2.0.0-alpha.6",
    "@webaudiomodules/sdk": "0.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
