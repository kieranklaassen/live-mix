  "params": [
    {
      "key": "stretch",
      "name": "Stretch",
      "min": -1,
      "max": 1,
      "default": 0.3,
      "description": "Pulls the partials apart or pushes them together around the pivot. Up, a string turns to a bell; down, they crowd into a beating cluster. The middle leaves them alone."
    },
    {
      "key": "lean",
      "name": "Lean",
      "min": -1,
      "max": 1,
      "default": 0,
      "description": "Where the stretch bites. Up, overtones near the pivot stay close and the far ones move most, as on a stiff string. Down, the near ones move and the far ones stay."
    },
    {
      "key": "drift",
      "name": "Drift",
      "min": 0,
      "max": 1,
      "default": 0.1,
      "description": "Lets the stretch wander slowly by itself, so the partials breathe in and out of tune like a bell turning in the air. Zero holds them still."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "Balance between the dry signal and the warped one. Part way, partials that moved only a little beat slowly against their dry selves."
    },
    {
      "key": "follow",
      "name": "Follow",
      "choices": ["Off", "On"],
      "default": 1,
      "description": "On puts a pivot on every note played, so melodies and chords keep their pitches and only overtones move. A note softer than the overtone it lies on moves with it."
    },
    {
      "key": "shift",
      "name": "Shift",
      "min": -12,
      "max": 12,
      "default": 0,
      "unit": "st",
      "description": "Transposes the whole warped sound after the stretch, pivot included."
    },
    {
      "key": "tone",
      "name": "Tone",
      "min": -1,
      "max": 1,
      "default": 0,
      "description": "Darkens or brightens the warped sound from the middle of the keyboard up. Stretching throws partials upward, and turning this down takes the edge off them."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "Stretches left and right a little differently around each note: overtones beat between the speakers, faster further up, and the note stays put. Zero keeps the image."
    },
    {
      "key": "pivot",
      "name": "Pivot",
      "min": 20,
      "max": 2000,
      "default": 220,
      "taper": "log",
      "unit": "Hz",
      "description": "The pitch that does not move while Follow is off. With Follow on every note played is its own pivot and this knob is not used."
    }
  ],
