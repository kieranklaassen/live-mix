  "params": [
    {
      "key": "capture",
      "name": "Capture",
      "choices": ["Off", "On"],
      "default": 1,
      "description": "On, the effect listens and learns the colour of what it hears, starting afresh each time. Off, what it learned is held. A capture is not saved with a piece."
    },
    {
      "key": "shape",
      "name": "Shape",
      "choices": [
        "Captured",
        "Open vowel",
        "Round vowel",
        "Thin vowel",
        "Hollow tube",
        "Bright bell",
        "Dark box"
      ],
      "default": 1,
      "description": "Which colour is pressed on the sound. Captured is the one learned with Capture, or the open vowel while nothing has been learned. The others are built in."
    },
    {
      "key": "amount",
      "name": "Amount",
      "min": -2,
      "max": 2,
      "default": 1,
      "description": "How hard the colour is pressed on. The middle leaves the sound alone. Further right presses harder, past the colour's own strength. To the left it is turned inside out."
    },
    {
      "key": "shift",
      "name": "Shift",
      "min": -24,
      "max": 24,
      "default": 0,
      "unit": "st",
      "description": "Slides the colour up or down the spectrum without changing the notes. Up makes the stamped body smaller and brighter, down larger and darker."
    },
    {
      "key": "replace",
      "name": "Replace",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "At zero the colour is laid over the sound's own. Turned up, the sound's own colour is flattened first, so different sounds come out with the same colour."
    },
    {
      "key": "smooth",
      "name": "Smooth",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "How fine the colour is. Low keeps every bump, down to single partials of what was captured. High keeps only the broad colour."
    },
    {
      "key": "learn",
      "name": "Learn",
      "min": 0.1,
      "max": 20,
      "default": 2,
      "taper": "log",
      "unit": "s",
      "description": "How long a moment Capture remembers. Short takes the colour of the last instant. Long averages everything heard while it listens."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "Balance between the untouched sound and the stamped one."
    }
  ],
