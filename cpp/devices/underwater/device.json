{
  "id": "underwater",
  "name": "Underwater",
  "category": "texture",
  "description": "Takes the sound under water: muffled, slowly wavering, closing in from the sides, with bubbles rising off the attacks. One knob for how deep.",
  "class": "Underwater",
  "header": "underwater.h",
  "sources": [],
  "meters": [
    {
      "key": "swell",
      "name": "Swell phase",
      "display": true
    },
    {
      "key": "ripple",
      "name": "Ripple phase",
      "display": true
    },
    {
      "key": "bubbles",
      "name": "Bubbles sent up",
      "display": true
    },
    {
      "key": "pitch",
      "name": "Last bubble pitch",
      "unit": "Hz",
      "display": true
    },
    {
      "key": "squeeze",
      "name": "Pressure gain",
      "display": true
    },
    {
      "key": "light",
      "name": "Light flicker",
      "display": true
    }
  ],
  "params": [
    {
      "key": "depth",
      "name": "Depth",
      "min": 0,
      "max": 1,
      "default": 0.55,
      "description": "How far under the sound is. Deeper is darker, narrower and more squeezed, and the body of the water rings lower. At the top it is out of the water and untouched."
    },
    {
      "key": "waver",
      "name": "Waver",
      "min": 0,
      "max": 1,
      "default": 0.35,
      "description": "How much the moving surface bends the pitch and the timing. Low is a slow sway, high is seasick."
    },
    {
      "key": "rate",
      "name": "Swell",
      "min": 0.05,
      "max": 3,
      "default": 0.3,
      "taper": "log",
      "unit": "Hz",
      "description": "How fast the surface moves. Slow is a long swell, fast is choppy water."
    },
    {
      "key": "bubbles",
      "name": "Bubbles",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "How many bubbles each attack sends up. A held or slowly swelling sound sends none."
    },
    {
      "key": "bubbleSize",
      "name": "Bubble Size",
      "min": 0,
      "max": 1,
      "default": 0.45,
      "description": "Small bubbles are quick, high chirps that come in a rush. Large ones are slow, low and spread out."
    },
    {
      "key": "resonance",
      "name": "Body",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "The ring of the body of water around the sound: a broad hump in the low mids that grows and sinks lower with Depth."
    },
    {
      "key": "surface",
      "name": "Surface",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Light on the water: a fast flicker of the top end. It shows near the surface and is lost as the sound goes deep."
    },
    {
      "key": "pressure",
      "name": "Pressure",
      "min": 0,
      "max": 1,
      "default": 0.35,
      "description": "How hard the water squeezes the sound as it goes deeper. Loud moments are held down and quiet ones come up."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "How much of left and right survives under water. Low settings close the sound in towards the middle as it goes deeper."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "Balance between the dry signal and the sound under water. Part way, the water is shallower and gentler, so the blend stays one sound."
    }
  ],
