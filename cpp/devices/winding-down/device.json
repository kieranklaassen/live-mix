{
  "id": "winding-down",
  "name": "Winding Down",
  "category": "modulation",
  "description": "Layers of one pulse, each twice as fast as the next, glide together and fade in and out, so the pulse seems to slow, or quicken, without end. It only turns sound down.",
  "class": "WindingDown",
  "header": "winding_down.h",
  "sources": [],
  "meters": [
    {
      "key": "place",
      "name": "Place in the halving",
      "display": true
    }
  ],
  "params": [
    {
      "key": "direction",
      "name": "Direction",
      "choices": ["Slower", "Quicker"],
      "default": 0,
      "description": "Whether the pulse seems to slow down or to quicken without end. Changing it turns the glide round from where it is, with no jump."
    },
    {
      "key": "rate",
      "name": "Rate",
      "min": 1,
      "max": 8,
      "default": 4,
      "taper": "log",
      "unit": "Hz",
      "description": "The pulse rate a layer has when it is loudest. Each layer glides through it, and the layers twice and half as fast are quieter on either side."
    },
    {
      "key": "halving",
      "name": "Halving",
      "min": 4,
      "max": 120,
      "default": 20,
      "taper": "log",
      "unit": "s",
      "description": "How long every layer takes to halve its rate, or to double it when quickening. Short is a plain slide, long is a very slow one."
    },
    {
      "key": "layers",
      "name": "Layers",
      "min": 2,
      "max": 5,
      "default": 4,
      "step": 1,
      "description": "How many layers sound at once. Two is one pulse crossing over to its double, five is a thick weave from very slow pulses to a flutter."
    },
    {
      "key": "depth",
      "name": "Depth",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "description": "How far the pulses turn the sound down. At zero nothing is changed. At full the sound is gone wherever every layer is in its gap."
    },
    {
      "key": "edge",
      "name": "Edge",
      "min": 2,
      "max": 50,
      "default": 15,
      "taper": "log",
      "unit": "ms",
      "description": "How long each pulse takes to rise and to fall. Short is a hard chop, long is a soft swell. A fast layer keeps it to a quarter of its own period."
    },
    {
      "key": "offset",
      "name": "Offset",
      "min": 0,
      "max": 180,
      "default": 0,
      "unit": "deg",
      "description": "How far behind the left ear the right ear's pulses come, in each layer's own cycle. At 180 the ears take turns, and in mono or from one speaker no pulse is left."
    }
  ],
