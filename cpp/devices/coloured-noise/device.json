{
  "id": "coloured-noise",
  "name": "Coloured Noise",
  "category": "instrument",
  "description": "A held key opens one bed of noise, from white through pink to brown, with low and high cuts. Keys can tint it with a faint pitch, and a slow drift keeps it moving.",
  "class": "ColouredNoise",
  "header": "coloured_noise.h",
  "sources": [],
  "params": [
    {
      "key": "colour",
      "name": "Colour",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "Slope of the noise. At 0 it is white and hissy, in the middle pink and even, at the top brown and deep. The level stays the same."
    },
    {
      "key": "lowCut",
      "name": "Low cut",
      "min": 20,
      "max": 2000,
      "default": 20,
      "taper": "log",
      "unit": "Hz",
      "description": "Removes what lies below this pitch, steeply. Raise it to keep a deep colour from rumbling."
    },
    {
      "key": "highCut",
      "name": "High cut",
      "min": 500,
      "max": 20000,
      "default": 20000,
      "taper": "log",
      "unit": "Hz",
      "description": "Removes what lies above this pitch, steeply. Lower it for a darker, softer bed."
    },
    {
      "key": "tint",
      "name": "Tint",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Adds a soft ringing band at the pitch of each held key, so the noise takes on a faint chord. At 0 the keys only open the bed."
    },
    {
      "key": "drift",
      "name": "Drift",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "description": "Depth of a slow, irregular swell: the bed keeps sinking and darkening, then coming back. At 0 the noise is steady."
    },
    {
      "key": "driftTime",
      "name": "Drift time",
      "min": 2,
      "max": 30,
      "default": 9,
      "taper": "log",
      "unit": "s",
      "description": "Average length of one swell. Each one lasts from half of this to one and a half times it, so the bed never keeps a beat."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "description": "At 0 both sides carry the same noise. At 1 each side has its own, widest on headphones. Speakers blend the two, and a mono fold is as loud at any setting."
    },
    {
      "key": "attack",
      "name": "Attack",
      "min": 0.01,
      "max": 10,
      "default": 2,
      "taper": "log",
      "unit": "s",
      "description": "How long the bed takes to fade in after a key goes down."
    },
    {
      "key": "release",
      "name": "Release",
      "min": 0.05,
      "max": 15,
      "default": 4,
      "taper": "log",
      "unit": "s",
      "description": "How long the bed takes to fade out after the last key is let go."
    },
    {
      "key": "volume",
      "name": "Volume",
      "min": -48,
      "max": 6,
      "default": -12,
      "unit": "dB",
      "description": "Output level of the whole instrument."
    }
  ],
