{
  "id": "freq-shifter",
  "name": "Frequency Shifter",
  "category": "pitch",
  "description": "Single-sideband frequency shifter: moves every partial by the same number of hertz, from slow phasing drift to bell tones, with a delayed feedback path for barber-pole spirals.",
  "class": "FreqShifter",
  "header": "freq_shifter.h",
  "sources": [],
  "params": [
    { "key": "shift", "name": "Shift", "min": -1000, "max": 1000, "default": 0, "unit": "Hz" },
    { "key": "fine", "name": "Fine", "min": -10, "max": 10, "default": 0.4, "unit": "Hz" },
    { "key": "mode", "name": "Mode", "choices": ["Up", "Down", "Stereo", "Ring"], "default": 0 },
    { "key": "feedback", "name": "Feedback", "min": 0, "max": 0.98, "default": 0.5 },
    {
      "key": "delay",
      "name": "Delay",
      "min": 1,
      "max": 500,
      "default": 45,
      "taper": "log",
      "unit": "ms"
    },
    {
      "key": "lfoRate",
      "name": "LFO Rate",
      "min": 0.01,
      "max": 10,
      "default": 0.08,
      "taper": "log",
      "unit": "Hz"
    },
    { "key": "lfoDepth", "name": "LFO Depth", "min": 0, "max": 1, "default": 0.08 },
    {
      "key": "tone",
      "name": "Tone",
      "min": 200,
      "max": 16000,
      "default": 4500,
      "taper": "log",
      "unit": "Hz"
    },
    { "key": "width", "name": "Width", "min": 0, "max": 1, "default": 0.6 },
    { "key": "mix", "name": "Mix", "min": 0, "max": 1, "default": 0.5 }
