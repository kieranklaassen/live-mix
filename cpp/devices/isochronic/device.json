{
  "id": "isochronic",
  "name": "Isochronic",
  "category": "instrument",
  "description": "Each key is a tone, or a band of noise at the key, switched on and off evenly by one pulse that all keys share. Offset sets the right ear's pulse behind the left's.",
  "class": "Isochronic",
  "header": "isochronic.h",
  "sources": [],
  "meters": [
    {
      "key": "glide",
      "name": "Place in the glide",
      "display": true
    }
  ],
  "params": [
    {
      "key": "rate",
      "name": "Rate",
      "min": 0.5,
      "max": 40,
      "default": 10,
      "taper": "log",
      "unit": "Hz",
      "description": "Pulses a second in each ear, shared by all keys. Slow is a plain on and off; fast runs together into a flutter. Moving it starts a glide again."
    },
    {
      "key": "duty",
      "name": "Duty",
      "min": 0.1,
      "max": 0.9,
      "default": 0.5,
      "description": "The share of each period the sound is on: low is short blips, high is long tones. A change waits for the next pulse, up to two seconds at the slowest Rate."
    },
    {
      "key": "edge",
      "name": "Edge",
      "min": 2,
      "max": 50,
      "default": 8,
      "taper": "log",
      "unit": "ms",
      "description": "How long each pulse takes to fade in and out. Short is hard, long is soft. Held to half the shorter of the on time and the gap. A change waits for the next pulse."
    },
    {
      "key": "depth",
      "name": "Depth",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "How far the sound drops between pulses. At full the gaps are silent; lower leaves the sound running under the pulse; at zero there is no pulse."
    },
    {
      "key": "offset",
      "name": "Offset",
      "min": 0,
      "max": 180,
      "default": 0,
      "unit": "deg",
      "description": "How far the right ear's pulse runs behind the left's. At 180 the ears take turns. Speakers or mono add the two, and at 180 with half Duty the pulse is gone."
    },
    {
      "key": "warmth",
      "name": "Warmth",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Adds the second and third partials to the tone. At zero the tone is a pure sine; higher is fuller and brighter. The noise of Air is not changed."
    },
    {
      "key": "air",
      "name": "Air",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Crossfades each key's tone into a band of noise centred on the key: only tone at zero, only noise at full. The noise is the same in both ears and softer than the tone."
    },
    {
      "key": "target",
      "name": "Target",
      "min": 0.5,
      "max": 40,
      "default": 10,
      "taper": "log",
      "unit": "Hz",
      "description": "The rate the pulse glides to when Glide is above zero. Moving it starts the glide again."
    },
    {
      "key": "glide",
      "name": "Glide",
      "min": 0,
      "max": 30,
      "default": 0,
      "unit": "min",
      "description": "Minutes the pulse takes to go from Rate to Target, from the first key on. Zero is off. Moving it starts the glide again from Rate."
    },
    {
      "key": "attack",
      "name": "Attack",
      "min": 0.005,
      "max": 10,
      "default": 0.3,
      "taper": "log",
      "unit": "s",
      "description": "How long a key takes to fade in under the pulses."
    },
    {
      "key": "release",
      "name": "Release",
      "min": 0.05,
      "max": 15,
      "default": 1.5,
      "taper": "log",
      "unit": "s",
      "description": "How long a key takes to fade out after it is let go."
    },
    {
      "key": "volume",
      "name": "Volume",
      "min": -48,
      "max": 6,
      "default": -6,
      "unit": "dB",
      "description": "Output level."
    }
  ],
