{
  "id": "reveal",
  "name": "Reveal",
  "category": "dynamics",
  "description": "Turns up what is quiet inside a sound, frequency by frequency, so overtones, breath and room come forward while what is already loud stays where it is.",
  "class": "Reveal",
  "header": "reveal.h",
  "sources": [],
  "params": [
    {
      "key": "amount",
      "name": "Amount",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "How far what is quiet is lifted toward the loudest sound around it. Low only opens the sound a little; all the way up makes everything as loud as everything else."
    },
    {
      "key": "range",
      "name": "Range",
      "min": 0,
      "max": 30,
      "default": 15,
      "unit": "dB",
      "description": "The most any frequency may be lifted. Low keeps the lift a gentle opening; high lets faint overtones and the room come right up."
    },
    {
      "key": "floor",
      "name": "Floor",
      "min": -96,
      "max": -36,
      "default": -66,
      "unit": "dB",
      "description": "Anything quieter than this is left where it is, so hiss and hum stay down. Lower it to reach fainter detail; raise it to lift only what is clearly there."
    },
    {
      "key": "rise",
      "name": "Rise",
      "min": 20,
      "max": 4000,
      "default": 300,
      "taper": "log",
      "unit": "ms",
      "description": "How long the lift takes to come up, and how long what was loud is remembered once it stops. Short clings to every moment; long lets a note bloom as it fades."
    },
    {
      "key": "focus",
      "name": "Focus",
      "min": -1,
      "max": 1,
      "default": 0,
      "description": "Which part of the sound is revealed most. Down is the low end, the middle treats every frequency alike, up is the air at the top."
    },
    {
      "key": "detail",
      "name": "Detail",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "description": "How finely the lift follows the spectrum. Down lifts broad regions like a tone control; up reaches single overtones and what lies between them."
    },
    {
      "key": "output",
      "name": "Output",
      "min": -12,
      "max": 12,
      "default": 0,
      "unit": "dB",
      "description": "Trim after the lift. The overall level is already held to that of the input, so this is only for taste."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "The balance of the untouched sound and the revealed one. The untouched sound is delayed to match, so the two never cancel."
    },
    {
      "key": "listen",
      "name": "Listen",
      "choices": ["Off", "On"],
      "default": 0,
      "description": "On plays only what is being added, so the settings can be tuned by ear. Turn it off again to hear the result."
    }
  ],
