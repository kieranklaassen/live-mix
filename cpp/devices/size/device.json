  "params": [
    {
      "key": "size",
      "name": "Size",
      "min": -1,
      "max": 1,
      "default": 0.4,
      "description": "How large the body of the sound is. Up is a bigger, darker thing and down a smaller, brighter one. The notes stay where they are."
    },
    {
      "key": "pitch",
      "name": "Pitch",
      "min": -12,
      "max": 12,
      "default": 0,
      "unit": "st",
      "step": 1,
      "description": "Moves the notes by semitones and keeps the body where Size has put it, so a shifted sound keeps its character."
    },
    {
      "key": "fine",
      "name": "Fine",
      "min": -50,
      "max": 50,
      "default": 0,
      "unit": "ct",
      "description": "Tunes the notes a little sharp or flat. With some dry sound in the mix it beats against the played notes like a second player."
    },
    {
      "key": "detail",
      "name": "Detail",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "How fine an outline is taken as the body. Low moves only the broad shape and is smoothest. High follows every partial, so more of the character moves and it gets rougher."
    },
    {
      "key": "wander",
      "name": "Wander",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Lets the size drift by itself around where Size is set, so the sound breathes between smaller and larger."
    },
    {
      "key": "rate",
      "name": "Rate",
      "min": 0.02,
      "max": 2,
      "default": 0.1,
      "taper": "log",
      "unit": "Hz",
      "description": "How fast the size drifts when Wander is up. Slow is a tide, fast is a wobble."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Makes the left side a little smaller and the right a little larger, and lets them drift apart, so the sound opens out across the speakers."
    },
    {
      "key": "tone",
      "name": "Tone",
      "min": -1,
      "max": 1,
      "default": 0,
      "description": "Tilts the result darker or brighter without changing how loud it is. Useful after a big change of size."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "Balance between the sound as played and the resized one. Part way, a shifted pitch plays along with the played notes."
    }
  ],
