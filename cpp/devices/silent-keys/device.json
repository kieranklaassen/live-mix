{
  "id": "silent-keys",
  "name": "Silent Keys",
  "category": "reverb",
  "description": "Strings under a chord held down without a sound: whatever plays wakes only the partials it shares with them, so anything dry blooms into that chord and dies away.",
  "class": "SilentKeys",
  "header": "silent_keys.h",
  "sources": [],
  "params": [
    {
      "key": "chord",
      "name": "Chord",
      "min": 1,
      "max": 8,
      "default": 1,
      "step": 1,
      "description": "Which chord of the list is held. Turning it lets the old keys go and holds the new ones; while the list walks it starts again from here."
    },
    {
      "key": "count",
      "name": "Count",
      "min": 1,
      "max": 8,
      "default": 4,
      "step": 1,
      "description": "How many chords of the list are walked through before it comes round to the first again. It does nothing while Every is at zero."
    },
    {
      "key": "every",
      "name": "Every",
      "min": 0,
      "max": 30,
      "default": 0,
      "unit": "s",
      "description": "How long each chord is held before the next one is. At zero the chord stays. After a full silence the walk starts again from Chord."
    },
    {
      "key": "spacing",
      "name": "Spacing",
      "choices": ["Close", "Open", "Wide"],
      "default": 0,
      "description": "How far apart the keys of a chord lie. Open lifts every second one an octave, Wide spreads them over three. The Keys shape stays as it is."
    },
