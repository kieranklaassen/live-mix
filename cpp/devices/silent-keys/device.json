    {
      "key": "partials",
      "name": "Partials",
      "min": 1,
      "max": 12,
      "default": 10,
      "step": 1,
      "description": "How many partials of each string can be woken. One is the key itself; more let a low sound ring the high partials it shares."
    },
    {
      "key": "tilt",
      "name": "Tilt",
      "min": -12,
      "max": 6,
      "default": -2,
      "unit": "dB",
      "description": "How strongly the upper partials answer against the low ones. Low is round and dark, high is glassy."
    },
    {
      "key": "sharpness",
      "name": "Sharpness",
      "min": 0,
      "max": 1,
      "default": 0.55,
      "description": "How closely a sound has to match a partial to wake it. Low lets noise, clicks and near misses in; high answers only held, matching tones."
    },
    {
      "key": "ring",
      "name": "Ring",
      "min": 0.2,
      "max": 30,
      "default": 5,
      "taper": "log",
      "unit": "s",
      "description": "How long a string sounds on after what woke it. Low strings last longer than this, high partials less."
    },
    {
      "key": "damper",
      "name": "Damper",
      "min": 20,
      "max": 4000,
      "default": 400,
      "taper": "log",
      "unit": "ms",
      "description": "How long the strings of the old chord take to fall silent when the chord changes. A key that both chords hold rings on."
    },
    {
      "key": "bass",
      "name": "Bass",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Adds two free strings, one and two octaves under the lowest key, at this level. They answer more of what is played, their partials lying closer."
    },
    {
      "key": "lift",
      "name": "Lift",
      "min": 0,
      "max": 36,
      "default": 18,
      "unit": "dB",
      "description": "How hard the sound drives the strings. Noise and soft playing need a lot; strings that already ring loudly take less, so it stays level."
    },
    {
      "key": "lowCut",
      "name": "Low cut",
      "min": 20,
      "max": 1000,
      "default": 50,
      "taper": "log",
      "unit": "Hz",
      "description": "The strings do not hear what lies under this. Raise it so a bass drum or rumble does not wake the low strings."
    },
    {
      "key": "tune",
      "name": "Tune",
      "min": -50,
      "max": 50,
      "default": 0,
      "unit": "ct",
      "description": "Moves every string sharp or flat together, to meet a sound that is not at concert pitch."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "description": "Spreads the strings across the stereo field, low keys to the left and high keys to the right. At zero they all stand in the centre."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "Balance between the sound as it came and the ringing strings. Fully up is the strings alone."
    },
    {
      "key": "output",
      "name": "Output",
      "min": -24,
      "max": 12,
      "default": 0,
      "unit": "dB",
      "description": "The level of everything that comes out, the dry sound and the strings together."
    }
