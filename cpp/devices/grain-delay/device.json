      "max": 2000,
      "default": 350,
      "taper": "log",
      "unit": "ms"
    },
    { "key": "spray", "name": "Spray", "min": 0, "max": 1, "default": 0.15 },
    { "key": "pitch", "name": "Pitch", "min": -24, "max": 24, "default": 12, "unit": "st" },
