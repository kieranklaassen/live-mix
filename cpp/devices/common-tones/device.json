  "params": [
    {
      "key": "ago",
      "name": "Ago",
      "min": 50,
      "max": 8000,
      "default": 350,
      "taper": "log",
      "unit": "ms",
      "description": "How far back the sound is compared with itself. Short takes the attack off each note; long keeps only what has been sounding for a while."
    },
    {
      "key": "keep",
      "name": "Keep",
      "choices": ["Common", "Changes"],
      "default": 0,
      "description": "Common lets through what the sound shares with its past, so held tones stay. Changes lets through what is new, so held tones go."
    },
    {
      "key": "strict",
      "name": "Strict",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "description": "How alike now and then must be at a frequency to count as shared. Low counts anything that was there at all; high needs it to have been as loud."
    },
    {
      "key": "ring",
      "name": "Ring",
      "min": 0,
      "max": 1,
      "default": 0.45,
      "description": "How long what gets through hangs on after it stops. At nothing it ends with the sound; high leaves a long tail."
    },
    {
      "key": "broad",
      "name": "Broad",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "Compares wider regions of the spectrum, so a note that bends or wavers still counts as the same. At nothing every fine partial is judged alone."
    },
    {
      "key": "memory",
      "name": "Memory",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Compares with an average of the past and not one moment. Higher remembers longer, so shared tones fade in slowly and stay counted through a pause."
    },
    {
      "key": "floor",
      "name": "Floor",
      "min": -36,
      "max": 0,
      "default": -36,
      "unit": "dB",
      "description": "How far the rest is turned down. Fully down it is gone; higher leaves a ghost of it under what is kept."
    },
    {
      "key": "makeup",
      "name": "Make Up",
      "min": 0,
      "max": 1,
      "default": 0.75,
      "description": "How much of the level the comparison takes away is made up, by turning what is kept up slowly, never past the dry sound at its loudest. At nothing it is left as it falls."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "description": "Balance between the dry signal and what the comparison lets through."
    }
  ],
