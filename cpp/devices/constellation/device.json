{
  "id": "constellation",
  "name": "Constellation",
  "category": "delay",
  "description": "Up to twelve echoes scattered like stars over one span of time, each with its own moment, side and brightness, placed by a pattern that never falls on a regular pulse.",
  "class": "Constellation",
  "header": "constellation.h",
  "sources": [],
  "memoryMb": 8,
  "meters": [
    {
      "key": "span",
      "name": "Span now",
      "unit": "ms",
      "display": true
    },
    {
      "key": "clock",
      "name": "Drift clock",
      "unit": "s",
      "display": true
    }
  ],
  "params": [
    {
      "key": "span",
      "name": "Span",
      "min": 100,
      "max": 8000,
      "default": 2400,
      "taper": "log",
      "unit": "ms",
      "description": "The length of the sky: how long after a note its last star sounds. Moving it bends the pitch of the echoes already on their way."
    },
    {
      "key": "stars",
      "name": "Stars",
      "min": 1,
      "max": 12,
      "default": 7,
      "step": 1,
      "description": "How many echoes sound. The last star sits at the end of the span, and each one added lights another place of the pattern."
    },
    {
      "key": "pattern",
      "name": "Pattern",
      "choices": ["Spiral", "Cluster", "Scatter", "Ladder", "Gather"],
      "default": 0,
      "description": "How the stars are placed. Spiral slows down, Cluster comes in groups, Scatter is irregular, Ladder steps across the sides and Gather speeds up."
    },
    {
      "key": "shuffle",
      "name": "Shuffle",
      "min": 1,
      "max": 16,
      "default": 1,
      "step": 1,
      "description": "Another sky of the same pattern: the stars keep their kind of placement and take new moments, sides and brightness."
    },
    {
      "key": "fade",
      "name": "Fade",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "How much quieter and darker the later stars are than the early ones. At zero every star is as bright as the pattern made it."
    },
    {
      "key": "again",
      "name": "Again",
      "min": 0,
      "max": 1,
      "default": 0.35,
      "description": "Feeds the end of the span back in, so the whole sky sounds again a span later, quieter and thinner each time. At the top it hangs on for minutes."
    },
    {
      "key": "tone",
      "name": "Tone",
      "min": 500,
      "max": 16000,
      "default": 7000,
      "taper": "log",
      "unit": "Hz",
      "description": "The brightness of the stars. Lower settings make every echo darker, and each pass of Again darker still."
    },
    {
      "key": "drift",
      "name": "Drift",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Lets each star's time wander slowly on its own, so the echoes shimmer a little in pitch against each other."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.8,
      "description": "How far the stars sit to the left and right. At zero they all sound in the centre."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "Balance between the dry signal and the stars."
    }
  ],
