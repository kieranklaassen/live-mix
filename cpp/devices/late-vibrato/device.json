{
  "id": "late-vibrato",
  "name": "Late Vibrato",
  "category": "modulation",
  "description": "A vibrato that waits: held notes begin straight and start to sway the longer they last, as a singer or a bow would.",
  "class": "LateVibrato",
  "header": "late_vibrato.h",
  "sources": [],
  "latencySamples": 960,
  "meters": [
    {
      "key": "age",
      "name": "Note age",
      "unit": "s",
      "display": true
    },
    {
      "key": "depth",
      "name": "Sway depth",
      "unit": "ct",
      "display": true
    },
    {
      "key": "phase",
      "name": "Sway phase",
      "display": true
    },
    {
      "key": "rate",
      "name": "Sway rate",
      "unit": "Hz",
      "display": true
    }
  ],
  "params": [
    {
      "key": "wait",
      "name": "Wait",
      "min": 10,
      "max": 4000,
      "default": 350,
      "taper": "log",
      "unit": "ms",
      "description": "How long a note is held before it starts to sway. Notes shorter than this pass straight through."
    },
    {
      "key": "grow",
      "name": "Grow",
      "min": 20,
      "max": 8000,
      "default": 900,
      "taper": "log",
      "unit": "ms",
      "description": "How long the sway takes to open from nothing to its full depth once the wait is over."
    },
    {
      "key": "depth",
      "name": "Depth",
      "min": 0,
      "max": 100,
      "default": 28,
      "unit": "ct",
      "description": "How far the pitch bends each way once the sway is fully open. Slow rates hold less of it than fast ones."
    },
    {
      "key": "rate",
      "name": "Rate",
      "min": 0.3,
      "max": 10,
      "default": 5.2,
      "taper": "log",
      "unit": "Hz",
      "description": "How fast the pitch sways as it begins. Slow is a drift; fast is a nervous shake."
    },
    {
      "key": "quicken",
      "name": "Quicken",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Speeds the sway up as it opens, the way a player presses into a long note. Zero keeps one rate throughout."
    },
    {
      "key": "swell",
      "name": "Swell",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "Lets level and brightness rise with the sway and pulse along with each cycle, so a held note opens up as it starts to move."
    },
    {
      "key": "human",
      "name": "Human",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "Lets the rate and the depth wander slowly, so no two cycles are quite alike. Zero is a perfectly even sway."
    },
    {
      "key": "sense",
      "name": "Sense",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "description": "How small an attack counts as a new note and sends the sway back to straight. Low, only a note after silence does; high, every new touch does."
    },
    {
      "key": "width",
      "name": "Width",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "description": "Moves the right side's sway out of step with the left, so a held note spreads across the stereo field as it opens."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 1,
      "description": "Balance between the straight sound and the swaying one. Part way, a held note opens into a chorus instead of a vibrato."
    }
  ],
