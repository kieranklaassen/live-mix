{
  "id": "orbits",
  "name": "Orbits",
  "category": "delay",
  "description": "Two to five loops of unequal lengths record what you play and turn against each other, so the layers never meet the same way twice.",
  "class": "Orbits",
  "header": "orbits.h",
  "sources": [],
  "memoryMb": 32,
  "meters": [
    { "key": "phase1", "name": "Loop 1 place", "display": true },
    { "key": "phase2", "name": "Loop 2 place", "display": true },
    { "key": "phase3", "name": "Loop 3 place", "display": true },
    { "key": "phase4", "name": "Loop 4 place", "display": true },
    { "key": "phase5", "name": "Loop 5 place", "display": true },
    { "key": "level1", "name": "Loop 1 level", "display": true },
    { "key": "level2", "name": "Loop 2 level", "display": true },
    { "key": "level3", "name": "Loop 3 level", "display": true },
    { "key": "level4", "name": "Loop 4 level", "display": true },
    { "key": "level5", "name": "Loop 5 level", "display": true }
  ],
  "params": [
    {
      "key": "loops",
      "name": "Loops",
      "min": 2,
      "max": 5,
      "default": 3,
      "step": 1,
      "description": "How many loops turn at once. Each one hears the same playing and brings it back at its own length."
    },
    {
      "key": "length",
      "name": "Length",
      "min": 0.25,
      "max": 12,
      "default": 2,
      "taper": "log",
      "unit": "s",
      "description": "How long the first loop is, the time before a note comes round again. Moving it bends the pitch of what the loops hold."
    },
    {
      "key": "offset",
      "name": "Offset",
      "min": 0.1,
      "max": 30,
      "default": 1.5,
      "taper": "log",
      "description": "How much longer each loop is than the one before. Small and the copies slide slowly out of step, large and the loops hardly ever line up again."
    },
    {
      "key": "feedback",
      "name": "Feedback",
      "min": 0,
      "max": 1,
      "default": 0.8,
      "description": "How much of each pass is kept for the next. Low and layers die away quickly. At the top the loops hold what they have and new playing presses old layers down."
    },
    {
      "key": "wear",
      "name": "Wear",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "What each pass costs a layer: duller highs and soft saturation, so old layers sink into the background. At zero a pass is an exact copy."
    },
    {
      "key": "drift",
      "name": "Drift",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "description": "A slow wander in the speed each loop plays at, different for every loop, so the copies shift against each other and float in pitch. It is not recorded."
    },
    {
      "key": "spread",
      "name": "Spread",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "description": "Places the loops across the stereo field, alternating left and right from the middle outward. At zero they all sit in the middle."
    },
    {
      "key": "hold",
      "name": "Hold",
      "choices": ["Off", "On"],
      "default": 0,
      "description": "On stops the loops listening and keeps what they hold going round without fading or wearing. Off lets new playing in again."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "Balance between the dry signal and the loops."
    }
  ],
