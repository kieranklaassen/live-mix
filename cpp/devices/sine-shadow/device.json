  "params": [
    {
      "key": "partials",
      "name": "Partials",
      "min": 1,
      "max": 24,
      "default": 8,
      "step": 1,
      "description": "How many partials are followed at once. One is a single sine on the strongest tone, a few draw the outline of a chord, many redraw the whole sound."
    },
    {
      "key": "transpose",
      "name": "Transpose",
      "min": -12,
      "max": 24,
      "default": 0,
      "unit": "st",
      "step": 1,
      "description": "Moves the whole shadow up or down in pitch. An octave up is a halo over the sound, an octave down a floor under it."
    },
    {
      "key": "attack",
      "name": "Attack",
      "min": 20,
      "max": 8000,
      "default": 350,
      "taper": "log",
      "unit": "ms",
      "description": "How slowly each sine swells in once its partial is found. Short settings trace the playing, long ones let the shadow rise well after the note."
    },
    {
      "key": "release",
      "name": "Release",
      "min": 0.1,
      "max": 30,
      "default": 3,
      "taper": "log",
      "unit": "s",
      "description": "How long each sine lingers after its partial fades or stops. Long settings leave a slow wash of pure tones behind the playing."
    },
    {
      "key": "snap",
      "name": "Snap",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "Pulls every sine toward the nearest note. At zero the sines sit exactly on the partials, at full they sit on the notes of the keyboard."
    },
    {
      "key": "steady",
      "name": "Steady",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "description": "How long a partial has to last before it gets a sine. Low settings catch every flicker and noise, high ones keep only held tones."
    },
    {
      "key": "glide",
      "name": "Glide",
      "min": 5,
      "max": 2000,
      "default": 40,
      "taper": "log",
      "unit": "ms",
      "description": "How slowly a sine reaches its pitch. Long settings smooth out vibrato and let each new sine slide in from the nearest one still sounding."
    },
    {
      "key": "spread",
      "name": "Spread",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "Places the sines across the sides, each note at a spot of its own. At zero every sine sits where its partial is in the sound."
    },
    {
      "key": "tone",
      "name": "Tone",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "Which partials cast the shadow. Left of centre favours the low ones for a dark shadow, right of centre the high ones for a bright one."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "description": "Balance between the sound and its shadow. All the way up leaves only the sines."
    }
  ],
