  "memoryMb": 10,
  "params": [
    {
      "key": "fall",
      "name": "Fall",
      "min": -24,
      "max": 24,
      "default": -7,
      "unit": "st",
      "description": "How far each piece bends over its length. Below the middle the pieces sink, above it they rise, and at the middle they stay at the pitch they were caught at."
    },
    {
      "key": "curve",
      "name": "Curve",
      "min": -1,
      "max": 1,
      "default": 0.5,
      "description": "Where in a piece the bend happens. In the middle it is a straight slide. Higher holds the pitch and lets go late. Lower drops at once and settles."
    },
    {
      "key": "size",
      "name": "Size",
      "min": 60,
      "max": 3000,
      "default": 700,
      "taper": "log",
      "unit": "ms",
      "description": "How long each piece lasts. Short pieces are a rain of little falls. Long pieces are slow sighs."
    },
    {
      "key": "density",
      "name": "Density",
      "min": 0.3,
      "max": 40,
      "default": 5,
      "taper": "log",
      "unit": "/s",
      "description": "How many pieces start each second. Low leaves single falls with space between them. High overlaps them into one sinking cloud, never more than sixteen at once."
    },
    {
      "key": "scatter",
      "name": "Scatter",
      "min": 0,
      "max": 1,
      "default": 0.25,
      "description": "How far back in the last seconds a piece may be taken from. At zero every piece is what was just played. Higher brings back older sound."
    },
    {
      "key": "vary",
      "name": "Vary",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "description": "Makes each piece bend a different distance. At zero they all move alike. Turned up, some barely move and a few go the other way."
    },
    {
      "key": "shape",
      "name": "Shape",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "description": "How a piece fades in and out. Low is a soft swell and fade. High starts quickly and spends the rest of its length dying away."
    },
    {
      "key": "spread",
      "name": "Spread",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "description": "How far the pieces are thrown to the left and right. Zero keeps every piece in the centre."
    },
    {
      "key": "again",
      "name": "Again",
      "min": 0,
      "max": 0.95,
      "default": 0.2,
      "description": "Lets the pieces be caught again, so a fall falls further each time round and the cloud outlasts the sound that fed it."
    },
    {
      "key": "tone",
      "name": "Tone",
      "min": 400,
      "max": 16000,
      "default": 8000,
      "taper": "log",
      "unit": "Hz",
      "description": "Darkens the pieces. Lower takes more of their highs away, and with Again each time round takes more."
    },
    {
      "key": "mix",
      "name": "Mix",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "description": "Balance between the dry signal and the falling pieces."
    }
  ],
