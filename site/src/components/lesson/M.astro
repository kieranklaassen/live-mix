---
// An equation, set when the site is built: <M t={String.raw`y[n] = x[n] + a\,y[n-1]`} />, and
// with `block` on a line of its own.
import katex from 'katex'

interface Props {
  t: string
  block?: boolean
}
const { t, block = false } = Astro.props
const html = katex.renderToString(t, {
  displayMode: block,
  throwOnError: true,
  output: 'htmlAndMathml',
})
---

{block ? <div class="math" set:html={html} /> : <span class="math-inline" set:html={html} />}
