---
// An equation, set when the site is built: <M t={String.raw`y[n] = x[n] + a\,y[n-1]`} />, and
// with `block` on a line of its own. Two commands are added to the mathematics:
// \sig{out}{y[n]} sets a term in the colour of a signal's role (in, out, ctl, alt, alt2, alt3),
// and \at{filters-L19}{a} links a term to a line of a listing on the page.
import { mathsHtml } from '../../lib/maths.ts'

interface Props {
  t: string
  block?: boolean
}
const { t, block = false } = Astro.props
const html = mathsHtml(t, block)
---

{block ? <div class="math" set:html={html} /> : <span class="math-inline" set:html={html} />}
