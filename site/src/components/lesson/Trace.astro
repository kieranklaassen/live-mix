---
// Values the device works out, against time: <Trace taps="level reduction" lines="threshold" min={-60} max={0}>Caption.</Trace>
import Trace from '../../figures/Trace.tsx'
import { tapRefs } from '../../figures/roles.ts'
import { controlPairs, pageLab } from '../../lib/lab-info.ts'

interface Props {
  taps: string
  min?: number
  max?: number
  unit?: string
  from?: number
  span?: number
  /** Controls drawn as a level line across the picture, by id. */
  lines?: string
  height?: number
  label?: string
}
const { taps, lines, label, ...rest } = Astro.props
const { lab, lesson } = pageLab(Astro.locals)
const refs = tapRefs(taps, lab.taps, lesson)
const said = label ?? `${refs.map((tap) => tap.name).join(' and ')} against time`
---

<figure class="fig">
  <Trace
    client:visible
    taps={refs}
    lines={controlPairs(lines, lab, lesson)}
    label={said}
    {...rest}
  />
  <figcaption>
    <slot />
  </figcaption>
</figure>
