---
// A picture rendered from the lab when the site is built, as inline SVG with a key and a caption:
// <Still taps="in out" set="pump" view="wave" from={1} span={2} caption="What to notice." />
// <Still taps="in out" view="spectrum" min={-80} max={0} top={8000} caption="What to notice." />
// <Still taps="in out" view="spectrum" scale="linear" top={2000} caption="What to notice." />
// <Still taps="impulse" view="curve" from={0} span={2} xTitle="milliseconds" stems caption="What to notice." />
// <Still taps="in built" values={{ build: 3 }} caption="The build at its fourth step." />
// <Still taps="loss" view="curve" xTitle="hertz" yTitle="gain" caption="What to notice." />
// <Still taps="out" channels="both" caption="The two sides, each a line of the key." />
// A sound of two channels is drawn by its left, and the picture says so under its key.
// It is in the page with scripts off and costs the browser nothing. Its lines are in their
// roles' colours, as a live figure's are. A tap the lab does not have, or a set the lesson's
// settings file does not have, stops the build, naming the lesson. So does a range that does not
// run upwards and a top that is not a frequency the picture can reach.
import { getEntry } from 'astro:content'
import { ROLE_VAR } from '../../figures/roles.ts'
import { pageLab } from '../../lib/lab-info.ts'
import { lessonStill, plotHtml, type PictureView } from '../../lib/still.ts'

interface Props {
  /** The taps drawn, "in out" or "in level:alt", in the order they are drawn. */
  taps: string
  /** A set of the lesson's settings file, by name. Left out, the lab's starting values. */
  set?: string
  /**
   * Control values by id, laid over the set's. `build` among them is the step of the build path
   * the picture is drawn at, counted from 0, for a tap whose id begins `built`.
   */
  values?: Record<string, number>
  /** One of the lesson's sources. Left out, the set's, and then the lesson's first. */
  source?: string
  /** `wave` (against time) when left out; `spectrum`, `spectrogram` or `curve`. */
  view?: PictureView
  /**
   * The span of time drawn, in seconds: where it starts, and its length (to the loop's end when
   * left out). For a curve, the stretch of it drawn, in the unit of the curve's own x axis.
   */
  from?: number
  span?: number
  /**
   * The vertical range, in the view's own unit: decibels for a spectrum and for the levels of a
   * spectrogram, the curve's unit for a curve, amplitude for a wave. An end left out is fitted.
   * Two stills meant to be compared are given the same.
   */
  min?: number
  max?: number
  /** The highest frequency drawn by a spectrum and a spectrogram, in hertz. Fitted when left out. */
  top?: number
  /**
   * A spectrum's frequencies evenly from 0 Hz to its `top`, where harmonics stand evenly
   * (`linear`); in even ratios from 20 Hz when left out (`log`).
   */
  scale?: 'log' | 'linear'
  /**
   * What runs along the bottom, in a word or two: "milliseconds" under a curve, which has no
   * word of its own. In place of "seconds" for a view against time or a spectrogram.
   */
  xTitle?: string
  /**
   * Taps drawn as a dot on a stem for each point, against time or as a curve, for a stretch
   * short enough to count its samples: every tap (`stems`), or those named (`stems="frame"`).
   */
  stems?: boolean | string
  /**
   * What stands over the y axis, in a word or two, in place of the tap's own unit: for a curve
   * or a value whose unit belongs to the other axis. Against time and for a curve.
   */
  yTitle?: string
  /**
   * `both` draws each channel of a sound that has two, against time and as a spectrum, each a
   * line the key names. Left out, the left alone is drawn, and the picture says so.
   */
  channels?: 'left' | 'both'
  /** What to notice in the picture. */
  caption: string
}
const { caption, ...asked } = Astro.props
const { lesson } = pageLab(Astro.locals)
const entry = await getEntry('lessons', lesson)
if (!entry) throw new Error(`${lesson}: a still was used on a page that is not a lesson's.`)
const picture = await lessonStill(entry, asked)
---

<figure class="fig still">
  <Fragment set:html={plotHtml(picture)} />
  <ul class="fig-legend">
    {picture.key.map((line) => (
      <li>
        <i
          style={`background: var(${ROLE_VAR[line.role]})`}
          class={line.dashed ? 'dashed' : undefined}
        />
        {line.name}
      </li>
    ))}
    {picture.note && (
      <li>
        {picture.ramp && <i class="ramp" />}
        {picture.note}
      </li>
    )}
  </ul>
  <figcaption>{caption}</figcaption>
</figure>
