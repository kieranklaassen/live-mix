---
// A link to a file of the engine at the commit the site was built from:
// <Src path="cpp/kit/fft.h" /> or
// <Src path="cpp/kit/fft.h" at="for (int k = 0; k < half; ++k)">the butterfly loop</Src>, and
// with `to` as well, the lines from one text to the other. The lines are found by the text, so
// the build fails when the file no longer holds it once. Lines are never given by number:
// `lines="40-62"` stops the build.
import fs from 'node:fs'
import path from 'node:path'
import { sourceAnchor } from '../../lib/listing.ts'
import { REPO_ROOT, sourceUrl } from '../../lib/site.ts'

interface Props {
  path: string
  /** Text on the line linked to, or on the first of the lines. */
  at?: string
  /** Text on the last of the lines, with `at`. */
  to?: string
}
const { path: file } = Astro.props
if (!fs.existsSync(path.join(REPO_ROOT, file))) {
  throw new Error(
    `${Astro.locals.lesson ?? 'A page'} links to ${file}, which is not in the repository.`,
  )
}
// Handed over whole: a `lines` a lesson still writes is found there and refused.
const anchor = sourceAnchor(file, Astro.props, Astro.locals.lesson)
---

<a class="src" href={`${sourceUrl(file)}${anchor}`}><slot><code>{file}</code></slot></a>
