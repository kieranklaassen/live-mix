---
import '../../styles/devices.css'
import '../../styles/lesson.css'
import DeviceBench from '../../figures/DeviceBench.tsx'
import PlayBar from '../../figures/PlayBar.tsx'
import { SOURCES } from '../../lab/sources.ts'
import Base from '../../layouts/Base.astro'
import ParamTable from '../../components/ParamTable.astro'
import { catalogue, lessonsUsing, presetSettings, type CatalogueDevice } from '../../lib/devices'
import { lessonPath, lessonsInOrder } from '../../lib/lessons'
import { href } from '../../lib/paths'
import { sourceUrl } from '../../lib/site'

export async function getStaticPaths() {
  const lessons = (await lessonsInOrder()).map((lesson) => ({
    id: lesson.id,
    title: lesson.data.title,
    order: lesson.data.order,
    summary: lesson.data.summary,
    devices: lesson.data.devices,
  }))
  return catalogue().map((device) => ({
    params: { id: device.id },
    props: { device, lessons: lessonsUsing(device.id, lessons) },
  }))
}

interface Props {
  device: CatalogueDevice
  lessons: { id: string; title: string; order: number; summary: string }[]
}
const { device, lessons } = Astro.props

// The bench: an effect is heard on a loop, an instrument plays a phrase. The rack holds other
// devices and has no sound of its own; the convolver puts out only its wet sound, so it is
// heard beside the dry loop, as a send is.
const benched = device.id !== 'rack'
const instrument = device.category === 'instrument'
const as = instrument ? 'instrument' : device.id === 'convolver-reverb' ? 'send' : 'insert'
const sources = SOURCES.filter((source) =>
  ['drums', 'guitar', 'chords', 'noise', 'sine'].includes(source.id),
)
---

<Base title={device.name} description={device.description || undefined}>
  <article class="device">
    {/* Out of the search's text: an excerpt would open with it on every device's page. */}
    <p class="label crumb" data-pagefind-ignore>
      <a href={href('devices/')}>Devices</a> /{' '}
      <a href={href(`devices/#${device.category}`)}>{device.family}</a>
    </p>
    <h1>{device.name}</h1>
    {device.description && <p class="lede">{device.description}</p>}

    <dl class="facts">
      <dt>Id</dt>
      <dd>
        <code>{device.id}</code>
      </dd>
      <dt>Family</dt>
      <dd>{device.family}</dd>
      <dt>Source</dt>
      <dd>
        <a href={sourceUrl(device.source)}>
          <code>{device.source}</code>
        </a>
      </dd>
    </dl>
    {device.experimental && (
      <p class="note">
        The library marks this device experimental: it is shipped, and not yet cleared for
        production. <a href={href('docs/devices/')}>The devices doc</a> has the measurements.
      </p>
    )}

    {benched && (
      <section id="bench" data-device={device.id}>
        <h2>{instrument ? 'Play it' : 'Hear it'}</h2>
        <p>
          {instrument
            ? 'The device itself, running in the engine in this page, played a short phrase that comes round.'
            : "The device itself, running in the engine in this page, on a loop the engine's own instruments play."}
        </p>
        <DeviceBench client:visible device={device.id} name={device.name} params={{}} as={as} />
      </section>
    )}

    <h2 id="controls">Controls</h2>
    <ParamTable params={device.params} />

    {device.presets.length > 0 && (
      <section>
        <h2 id="presets">Presets</h2>
        <div class="table-scroll">
          <table class="preset-table">
            <thead>
              <tr>
                <th scope="col">Preset</th>
                <th scope="col">What it sets</th>
              </tr>
            </thead>
            <tbody>
              {device.presets.map((preset) => {
                const settings = presetSettings(device, preset)
                return (
                  <tr>
                    <th scope="row">{preset.name}</th>
                    <td>
                      {settings.length > 0
                        ? settings.map(({ name, value }) => `${name} ${value}`).join(', ')
                        : 'Every control at its default.'}
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {lessons.length > 0 && (
      <section>
        <h2 id="lessons">Lessons</h2>
        <ol class="lesson-list">
          {lessons.map((lesson) => (
            <li>
              <a href={href(lessonPath(lesson.id))}>
                <span class="n">{String(lesson.order).padStart(2, '0')}</span>
                <span class="t">{lesson.title}</span>
                <span class="s">{lesson.summary}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
  {benched && (
    <PlayBar
      client:load
      lab="through"
      seconds={4}
      sources={sources}
      stages={[{ id: 'in', name: 'The loop, dry' }]}
      bench={device.name}
    />
  )}
</Base>
