---
import Base from '../layouts/Base.astro'
import { lessonPath, lessonsInOrder } from '../lib/lessons'
import { href } from '../lib/paths'

const lessons = await lessonsInOrder()
---

<Base
  title="live-mix"
  description="An audio engine for the browser, its documentation, and lessons on how the sound is made."
  indexed={false}
>
  <section class="hero">
    <p class="label">An audio engine for the browser</p>
    <h1>Hear how the sound is made.</h1>
    <p class="lede">
      live-mix is a mixing engine with a library of instruments and effects, written in C++ and
      TypeScript. This site documents all of it, and teaches the signal processing underneath by
      running the engine's own code in the page, one stage at a time.
    </p>
    <p>
      <a class="button" href={href('lessons/')}>
        Start the lessons
      </a>
      <a class="button quiet" href={href('docs/getting-started/')}>
        Use the library
      </a>
    </p>
  </section>

  <div class="cards">
    <a class="card" href={href('lessons/')}>
      <span class="label">Learn</span>
      <h3>Lessons</h3>
      <p>
        The Fourier transform, compression, convolution and more. A loop goes in, and you see and
        hear what every stage does to it.
      </p>
    </a>
    <a class="card" href={href('docs/')}>
      <span class="label">Build</span>
      <h3>Docs</h3>
      <p>The engine, tracks, devices, the session, the React kit, and how to add a device.</p>
    </a>
    <a class="card" href={href('devices/')}>
      <span class="label">Browse</span>
      <h3>Devices</h3>
      <p>Every instrument and effect, with each control explained, to try in the page.</p>
    </a>
    <a class="card" href={href('api/')}>
      <span class="label">Look up</span>
      <h3>API</h3>
      <p>Every exported class, function and type, generated from the source.</p>
    </a>
  </div>

  {lessons.length > 0 && (
    <section>
      <h2>The lessons</h2>
      <ol class="lesson-list">
        {lessons.map((lesson) => (
          <li>
            <a href={href(lessonPath(lesson.id))}>
              <span class="n">{String(lesson.data.order).padStart(2, '0')}</span>
              <span class="t">{lesson.data.title}</span>
              <span class="s">{lesson.data.summary}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
</Base>
