---
import { Font } from 'astro:assets'
import '../styles/site.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { href } from '../lib/paths'

interface Props {
  title: string
  description?: string
  /** Pages that are an index of others, or the search page, stay out of the search index. */
  indexed?: boolean
}
const { title, description, indexed = true } = Astro.props
const full = title === 'live-mix' ? title : `${title} · live-mix`

// The scheme is the kit's Paper, or its Graphite when the system asks for dark. The script in the
// head decides before paint, so a dark system never sees a light flash, and the kit's tokens
// follow the attribute it sets. Which schemes are dark ones is said once, by `color-scheme` in
// site.css: a script that must know reads that, and tests for no scheme's name.
---

<!doctype html>
<html lang="en" class="lm-root" data-lm-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    {/* The two typefaces, from the site's own packages (astro.config.mjs): --font-sans, --font-mono. */}
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      ;(function () {
        var dark = window.matchMedia('(prefers-color-scheme: dark)')
        function set() {
          document.documentElement.setAttribute(
            'data-lm-theme',
            dark.matches ? 'graphite' : 'paper',
          )
        }
        set()
        dark.addEventListener('change', set)
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to the page
    </a>
    <Header />
    <main id="main" data-pagefind-body={indexed ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
